{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["pages/*"],
      "@configs/*": ["configs/*"],
      "@utils/*": ["utils/*"],
      "@tests/*": ["tests/*"]
    },
  }
}
